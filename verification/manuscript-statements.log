structure OddCycle.ClosedClass (n w : ℕ) (states : List OddCycle.State) : Prop
number of parameters: 3
fields:
  OddCycle.ClosedClass.nodup : states.Nodup
  OddCycle.ClosedClass.nonempty : states ≠ []
  OddCycle.ClosedClass.valid : ∀ s ∈ states, OddCycle.Valid n s
  OddCycle.ClosedClass.closed : ∀ s ∈ states,
      ∀ (t : OddCycle.State), OddCycle.EventStep (OddCycle.cycleAdjacent n) w s t → t ∈ states
  OddCycle.ClosedClass.communicate : ∀ s ∈ states,
      ∀ t ∈ states, OddCycle.EventReachable (OddCycle.cycleAdjacent n) w s t
constructor:
  OddCycle.ClosedClass.mk {n w : ℕ} {states : List OddCycle.State} (nodup : states.Nodup) (nonempty : states ≠ [])
    (valid : ∀ s ∈ states, OddCycle.Valid n s)
    (closed : ∀ s ∈ states, ∀ (t : OddCycle.State), OddCycle.EventStep (OddCycle.cycleAdjacent n) w s t → t ∈ states)
    (communicate : ∀ s ∈ states, ∀ t ∈ states, OddCycle.EventReachable (OddCycle.cycleAdjacent n) w s t) :
    OddCycle.ClosedClass n w states
OddCycle.closed_class_classification {n w : ℕ} {states : List OddCycle.State} (hn : 3 ≤ n) (hw : 1 ≤ w)
  (hc : OddCycle.ClosedClass n w states) :
  (∃ s ∈ states, OddCycle.height n s ≤ w ∧ states.Perm (OddCycle.orientationStates n (OddCycle.orientation n s))) ∨
    (∃ k, 1 ≤ k ∧ n = 2 * k * w + 1) ∧ states.Perm (OddCycle.exceptionalStates n w)
OddCycle.CycleState.terminal_iff_runs {n w : ℕ} (hn : 3 ≤ n) (hw : 1 ≤ w) (s : OddCycle.CycleState n) :
  OddCycle.ReachabilityQuotient.Terminal (OddCycle.CycleState.Step n w) s ↔
    OddCycle.ShortRuns n w ↑s ∨ OddCycle.ExceptionalRuns n w ↑s
OddCycle.PositivePositionAllocation.continuous_recurrent_iff_runs {n : ℕ} (a : OddCycle.PositivePositionAllocation n)
  (hn : 3 ≤ n) {w : ℕ} (hw : 1 ≤ w) (s : OddCycle.CycleState n) :
  (a.pathLaw ⋯ w s) (OddCycle.FiniteMarkov.continuousReturn a.total ⋯ s) = 1 ↔
    OddCycle.ShortRuns n w ↑s ∨ OddCycle.ExceptionalRuns n w ↑s
OddCycle.PositivePositionAllocation.continuous_eventually_one_class {n : ℕ} (a : OddCycle.PositivePositionAllocation n)
  (hn : 3 ≤ n) {w : ℕ} (hw : 1 ≤ w) (s : OddCycle.CycleState n) :
  ∀ᵐ (ω : OddCycle.FiniteMarkov.TimedSample (OddCycle.CycleState n)) ∂a.pathLaw ⋯ w s,
    ∃ i t,
      (OddCycle.ShortRuns n w ↑i ∨ OddCycle.ExceptionalRuns n w ↑i) ∧
        ∀ (u : NNReal),
          t ≤ u →
            OddCycle.EventReachable (OddCycle.cycleAdjacent n) w ↑i ↑(a.process ⋯ ω u) ∧
              OddCycle.EventReachable (OddCycle.cycleAdjacent n) w ↑(a.process ⋯ ω u) ↑i
OddCycle.exists_tall_terminal_iff {n w : ℕ} (hn : 3 ≤ n) (hw : 1 ≤ w) :
  (∃ s, OddCycle.ReachabilityQuotient.Terminal (OddCycle.CycleState.Step n w) s ∧ w < OddCycle.height n ↑s) ↔
    ∃ k, 1 ≤ k ∧ n = 2 * k * w + 1
OddCycle.exceptionalStates_closedClass {n w k : ℕ} (hw : 1 ≤ w) (hk : 1 ≤ k) (hn : n = 2 * k * w + 1) :
  OddCycle.ClosedClass n w (OddCycle.exceptionalStates n w)
OddCycle.exceptionalRuns_transition {n w pos initiating : ℕ} {s t : OddCycle.State} {side : Bool} (hn : 3 ≤ n)
  (hw : 1 ≤ w) (hs : OddCycle.Valid n s) (hex : OddCycle.ExceptionalRuns n w s)
  (he : OddCycle.transition (OddCycle.cycleAdjacent n) w s side pos = some (t, initiating)) :
  OddCycle.ExceptionalRuns n w t
OddCycle.exceptionalRuns_communicate {n w : ℕ} (hn : 3 ≤ n) (hw : 1 ≤ w) {s t : OddCycle.State}
  (hs : OddCycle.Valid n s) (ht : OddCycle.Valid n t) (hsex : OddCycle.ExceptionalRuns n w s)
  (htex : OddCycle.ExceptionalRuns n w t) : OddCycle.EventReachable (OddCycle.cycleAdjacent n) w s t
OddCycle.exceptional_orientation_count {n w k : ℕ} (hn : n = 2 * k * w + 1) (hw : 1 ≤ w) (hk : 1 ≤ k) :
  Nat.card (OddCycle.ExceptionalOrientation n w) = 2 * n
OddCycle.CycleState.exceptional_recurrent_state {n w : ℕ} (P : OddCycle.FiniteMarkov (OddCycle.CycleState n))
  (hsupport : ∀ (s t : OddCycle.CycleState n), 0 < P.prob s t → OddCycle.CycleState.Step n w s t ∨ s = t) {k : ℕ}
  (hn : n = 2 * k * w + 1) (hw : 1 ≤ w) (hk : 1 ≤ k) :
  ∃ s, OddCycle.ExceptionalRuns n w ↑s ∧ w < OddCycle.height n ↑s ∧ Filter.Tendsto (P.returnBy s) Filter.atTop (nhds 1)
OddCycle.ClosedClass.short_fiber {n w : ℕ} {states : List OddCycle.State} (hc : OddCycle.ClosedClass n w states)
  (hn : 0 < n) {s : OddCycle.State} (hs : s ∈ states) (hw : OddCycle.height n s ≤ w) :
  states.Perm (OddCycle.orientationStates n (OddCycle.orientation n s))
OddCycle.ClosedClass.exceptional_family {n w : ℕ} {states : List OddCycle.State} (hc : OddCycle.ClosedClass n w states)
  (hn : 3 ≤ n) (hw : 1 ≤ w) {s : OddCycle.State} (hs : s ∈ states) (hex : OddCycle.ExceptionalRuns n w s) :
  states.Perm (OddCycle.exceptionalStates n w)
OddCycle.reachable_of_orientation_eq {n budget : ℕ} {s t : OddCycle.State} (hs : OddCycle.Valid n s)
  (ht : OddCycle.Valid n t) (hori : OddCycle.orientation n s = OddCycle.orientation n t) :
  OddCycle.EventReachable (OddCycle.cycleAdjacent n) budget s t
OddCycle.orientationStep_iff_pathFlip {n w : ℕ} {s t : OddCycle.State} (hn : 3 ≤ n) (hw : 1 ≤ w)
  (hs : OddCycle.Valid n s) (ht : OddCycle.Valid n t) :
  OddCycle.CycleState.OrientationStep n w (OddCycle.orientation n s) (OddCycle.orientation n t) ∧
      OddCycle.orientation n s ≠ OddCycle.orientation n t ↔
    OddCycle.PathFlip n w s t
OddCycle.orientationStep_iff_circularFlip {n w : ℕ} {s t : OddCycle.State} (hn : 3 ≤ n) (hw : 1 ≤ w)
  (hs : OddCycle.Valid n s) (ht : OddCycle.Valid n t) :
  OddCycle.CycleState.OrientationStep n w (OddCycle.orientation n s) (OddCycle.orientation n t) ∧
      OddCycle.orientation n s ≠ OddCycle.orientation n t ↔
    OddCycle.CircularWord.CircularFlip w (OddCycle.orientation n s) (OddCycle.orientation n t)
OddCycle.CircularRun.terminal_iff {w : ℕ} (hw : 1 ≤ w) (r : List ℕ) :
  OddCycle.CircularRun.Terminal w r ↔ OddCycle.CircularRun.Short w r ∨ OddCycle.CircularRun.Exceptional w r
OddCycle.short_class_normalized_oi {n w : ℕ} (hn : 0 < n) (μ ν : OddCycle.PositiveOIAllocation n) {s : OddCycle.State}
  (hs : OddCycle.Valid n s) (hw : OddCycle.height n s ≤ w) :
  have states := OddCycle.orientationStates n (OddCycle.orientation n s);
  have W := OddCycle.normalizedOIWeight μ.toOICapacity ν.toOICapacity states;
  OddCycle.OIStationary (OddCycle.cycleAdjacent n) w μ.toOICapacity ν.toOICapacity states W ∧
    (List.map W states).sum = 1 ∧ ∀ t ∈ states, 0 < W t
OddCycle.ClosedClass.safe_normalized_oi {n w : ℕ} {states : List OddCycle.State} (hc : OddCycle.ClosedClass n w states)
  (hn : 3 ≤ n) (hw : 1 ≤ w) (hmod : n % (2 * w) ≠ 1) (μ ν : OddCycle.PositiveOIAllocation n) :
  have W := OddCycle.normalizedOIWeight μ.toOICapacity ν.toOICapacity states;
  OddCycle.OIStationary (OddCycle.cycleAdjacent n) w μ.toOICapacity ν.toOICapacity states W ∧
    (List.map W states).sum = 1 ∧ ∀ t ∈ states, 0 < W t
OddCycle.cycle_normalized_canonical_sharpness {n w : ℕ} (hn : 3 ≤ n) (hw : 2 ≤ w) :
  (∀ (μ ν : OddCycle.PositiveOIAllocation n) (states : List OddCycle.State),
      OddCycle.ClosedClass n w states →
        OddCycle.OIStationary (OddCycle.cycleAdjacent n) w μ.toOICapacity ν.toOICapacity states
          (OddCycle.normalizedOIWeight μ.toOICapacity ν.toOICapacity states)) ↔
    n % (2 * w) ≠ 1
OddCycle.balanced_is_exceptional {w : ℕ} (hw : 2 ≤ w) :
  (OddCycle.balancedStates w).Perm (OddCycle.exceptionalStates (2 * w + 1) w)
OddCycle.balanced_cardinality {w : ℕ} (hw : 2 ≤ w) :
  (List.filter (OddCycle.balanced w) (OddCycle.allStates (2 * w + 1))).toFinset.card =
    2 * (2 * w + 1) * (2 * w + 2) * (2 * w - 1).choose w
OddCycle.two_flow_completeness {w bigger pos initiating : ℕ} {s : OddCycle.State} {side : Bool} (hw : 2 ≤ w)
  (hbig : w < bigger) (hv : OddCycle.Valid (2 * w + 1) s) (hb : OddCycle.balanced w s = true)
  (hc :
    OddCycle.transition (OddCycle.cycleAdjacent (2 * w + 1)) w s side pos ≠
      OddCycle.transition (OddCycle.cycleAdjacent (2 * w + 1)) bigger s side pos) :
  (OddCycle.transition (OddCycle.cycleAdjacent (2 * w + 1)) w s side pos = some (OddCycle.flowTarget w, initiating) ↔
      s = OddCycle.flowSourceX w ∧ side = true ∧ pos = 0 ∧ initiating = w) ∧
    (OddCycle.transition (OddCycle.cycleAdjacent (2 * w + 1)) bigger s side pos =
        some (OddCycle.flowTarget w, initiating) ↔
      s = OddCycle.flowSourceY w ∧ side = true ∧ pos = 0 ∧ initiating = w)
OddCycle.uniform_defect {w : ℕ} (hw : 2 ≤ w) {theta : ℝ} (ht : 0 < theta) :
  OddCycle.balance (OddCycle.cycleAdjacent (2 * w + 1)) w (OddCycle.spikeRate theta) (OddCycle.balancedStates w)
      (OddCycle.canonicalWeight (OddCycle.spikeRate theta)) (OddCycle.flowTarget w) =
    1 / (↑w.factorial * OddCycle.shiftedProduct w theta) - 1 / (↑(2 * w).factorial * (theta + ↑(2 * w)))
OddCycle.uniform_defect_pos {w : ℕ} (hw : 2 ≤ w) {theta : ℝ} (ht : 0 < theta) (ht1 : theta < 1) :
  0 <
    OddCycle.balance (OddCycle.cycleAdjacent (2 * w + 1)) w (OddCycle.spikeRate theta) (OddCycle.balancedStates w)
      (OddCycle.canonicalWeight (OddCycle.spikeRate theta)) (OddCycle.flowTarget w)
OddCycle.uniform_defect_neg {w : ℕ} (hw : 2 ≤ w) {theta : ℝ} (ht1 : 1 < theta) :
  OddCycle.balance (OddCycle.cycleAdjacent (2 * w + 1)) w (OddCycle.spikeRate theta) (OddCycle.balancedStates w)
      (OddCycle.canonicalWeight (OddCycle.spikeRate theta)) (OddCycle.flowTarget w) <
    0
OddCycle.uniform_defect_two.{u_1} {K : Type u_1} [Field K] [CharZero K] {w : ℕ} (hw : 2 ≤ w) :
  OddCycle.balance (OddCycle.cycleAdjacent (2 * w + 1)) w (OddCycle.spikeRate 2) (OddCycle.balancedStates w)
      (OddCycle.canonicalWeight (OddCycle.spikeRate 2)) (OddCycle.flowTarget w) =
    -↑w / ↑(2 * w + 2).factorial
OddCycle.unit_exceptional_residual {n w k : ℕ} (hw : 1 ≤ w) (hk : 2 ≤ k) (hn : n = 2 * k * w + 1) :
  OddCycle.oiBalance (OddCycle.cycleAdjacent n) w (OddCycle.unitAllocation n).toOICapacity
      (OddCycle.unitAllocation n).toOICapacity (OddCycle.exceptionalStates n w)
      (OddCycle.oiCanonicalWeight (OddCycle.unitAllocation n).toOICapacity (OddCycle.unitAllocation n).toOICapacity)
      (OddCycle.unitPatternTarget n w (List.reverse (OddCycle.unitInterior n w k))) =
    (1 - ↑(2 * w * (k - 1))) / ↑n.factorial
OddCycle.unit_exceptional_not_stationary {n w k : ℕ} (hw : 1 ≤ w) (hk : 2 ≤ k) (hn : n = 2 * k * w + 1) :
  ¬OddCycle.OIStationary (OddCycle.cycleAdjacent n) w (OddCycle.unitAllocation n).toOICapacity
      (OddCycle.unitAllocation n).toOICapacity (OddCycle.exceptionalStates n w)
      (OddCycle.oiCanonicalWeight (OddCycle.unitAllocation n).toOICapacity (OddCycle.unitAllocation n).toOICapacity)
OddCycle.NineJobCycle.residual :
  OddCycle.oiBalance (OddCycle.cycleAdjacent 9) 2 (OddCycle.unitAllocation 9).toOICapacity
      (OddCycle.unitAllocation 9).toOICapacity (OddCycle.exceptionalStates 9 2)
      (OddCycle.oiCanonicalWeight (OddCycle.unitAllocation 9).toOICapacity (OddCycle.unitAllocation 9).toOICapacity)
      OddCycle.NineJobCycle.target =
    -1 / 120960
OddCycle.FiveJob.head_communication {s t : OddCycle.State} (hs : s ∈ OddCycle.FiveJob.support)
  (ht : t ∈ OddCycle.FiveJob.support) : OddCycle.FiveJob.HeadReachable s t
OddCycle.FiveJob.canonical_defect :
  OddCycle.balance OddCycle.FiveJob.adj 2 OddCycle.FiveJob.rate OddCycle.FiveJob.support
      (OddCycle.canonicalWeight OddCycle.FiveJob.rate) OddCycle.FiveJob.target =
    -(1 / 360)
OddCycle.FiveJob.certificate_stationary :
  OddCycle.Stationary OddCycle.FiveJob.adj 2 OddCycle.FiveJob.rate OddCycle.FiveJob.support OddCycle.FiveJob.weight
OddCycle.FiveJob.normalized_certificate_not_product.{u_1} {R : Type u_1} [Field R] [CharZero R] (Z : R) (hZ : Z ≠ 0) :
  ¬∃ K A B, ∀ s ∈ OddCycle.FiveJob.support, ↑(OddCycle.FiveJob.integerWeight s) / Z = K * A s.1 * B s.2
OddCycle.partiteColor_proper {w i j : ℕ} (hw : 2 ≤ w) (hi : i < 2 * w + 1) (hj : j < 2 * w + 1)
  (hadj : OddCycle.cycleAdjacent (2 * w + 1) i j = true) : OddCycle.partiteColor w i ≠ OddCycle.partiteColor w j
OddCycle.partiteColor_surjective {w : ℕ} (hw : 2 ≤ w) {c : ℕ} (hc : c < w + 1) :
  ∃ i < 2 * w + 1, OddCycle.partiteColor w i = c
OddCycle.CycleClassifier.classify_continuous_recurrence {n w : ℕ} (hn : 3 ≤ n) (hw : 1 ≤ w)
  (a : OddCycle.PositivePositionAllocation n) (s : OddCycle.CycleState n) :
  ((OddCycle.CycleClassifier.classify n w ↑s).value = true ↔
      (a.pathLaw ⋯ w s) (OddCycle.FiniteMarkov.continuousReturn a.total ⋯ s) = 1) ∧
    (OddCycle.CycleClassifier.classify n w ↑s).cost ≤ 33 * n + 18
OddCycle.ClosedClass.wordCutEquiv {n w : ℕ} {states : List OddCycle.State} (hc : OddCycle.ClosedClass n w states) :
  ↥states.toFinset ≃ ↥(Finset.image OddCycle.placement states.toFinset) × Fin (n + 1)
OddCycle.ClosedClass.canonical_length_marginal {n w : ℕ} {states : List OddCycle.State}
  (hc : OddCycle.ClosedClass n w states) (μ ν : ℕ → ℝ) (hμ : μ 0 = 0) (hν : ν 0 = 0) (k : Fin (n + 1)) :
  have W := OddCycle.oiCanonicalWeight (OddCycle.byLengthCapacity μ hμ) (OddCycle.byLengthCapacity ν hν);
  (∑ s, if List.length (↑s).1 = ↑k then W ↑s else 0) / ∑ s, W ↑s =
    OddCycle.lengthCanonicalWeight n μ ν ↑k / ∑ j, OddCycle.lengthCanonicalWeight n μ ν ↑j
OddCycle.constant_lengthGenerator {n : ℕ} {s : OddCycle.State} (hs : OddCycle.Valid n s) (adj : ℕ → ℕ → Bool)
  (budget : ℕ) (a b : ℝ) (f : ℕ → ℝ) :
  OddCycle.lengthGenerator adj budget (fun x => a) (fun x => b) s f =
    a * ↑(List.length s.1) * (f (List.length s.1 - 1) - f (List.length s.1)) +
      b * (↑n - ↑(List.length s.1)) * (f (List.length s.1 + 1) - f (List.length s.1))
OddCycle.unit_exceptional_queue_length_indistinguishability {n w k : ℕ} (hw : 1 ≤ w) (hk : 2 ≤ k)
  (hn : n = 2 * k * w + 1) :
  let C := OddCycle.exceptionalStates n w;
  have hc := ⋯;
  have η := hc.unitCanonical;
  have μ := (OddCycle.unitAllocation n).toOICapacity;
  η ∈ stdSimplex ℝ (OddCycle.ClassState C) ∧
    ¬(hc.unitKernel ⋯).StationaryVector η ∧
      ∃ π ∈ stdSimplex ℝ (OddCycle.ClassState C),
        (hc.unitKernel ⋯).StationaryVector π ∧
          (∀ (t : NNReal) (j : OddCycle.CycleState n),
              (hc.configurationLaw ⋯ π) {y | y t = j} = ENNReal.ofReal (hc.fullInitial π j)) ∧
            hc.lengthPathLaw ⋯ η = hc.lengthPathLaw ⋯ π ∧
              (∀ (j : Fin (n + 1)),
                  (∑ s,
                      if hc.queueLength s = j then
                        OddCycle.oiBalance (OddCycle.cycleAdjacent n) w μ μ C (OddCycle.normalizedOIWeight μ μ C) ↑s
                      else 0) =
                    0) ∧
                OddCycle.oiBalance (OddCycle.cycleAdjacent n) w μ μ C (OddCycle.normalizedOIWeight μ μ C)
                    (OddCycle.unitPatternTarget n w (List.reverse (OddCycle.unitInterior n w k))) <
                  0
