structure OddCycle.PositiveOIAllocation (n : ℕ) : Type
number of parameters: 1
parents:
  OddCycle.PositiveOIAllocation.toOICapacity : OddCycle.OICapacity ℝ
fields:
  OddCycle.OICapacity.value : OddCycle.Queue → ℝ
  OddCycle.OICapacity.empty : self.value [] = 0
  OddCycle.OICapacity.perm : ∀ {q r : OddCycle.Queue}, List.Perm q r → self.value q = self.value r
  OddCycle.PositiveOIAllocation.positive : ∀ (q : OddCycle.Queue),
      List.Subperm q (List.range n) → ∀ p < List.length q, 0 < self.increment q p
constructor:
  OddCycle.PositiveOIAllocation.mk {n : ℕ} (toOICapacity : OddCycle.OICapacity ℝ)
    (positive :
      ∀ (q : OddCycle.Queue), List.Subperm q (List.range n) → ∀ p < List.length q, 0 < toOICapacity.increment q p) :
    OddCycle.PositiveOIAllocation n
field notation resolution order:
  OddCycle.PositiveOIAllocation, OddCycle.OICapacity
